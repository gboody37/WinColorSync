<Window x:Class="WinColorSync.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinColorSync - Wallpaper Engine System Synchronizer" Height="500" Width="700"
        Background="#18181C" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🎨 WinColorSync" FontSize="24" FontWeight="Bold" Foreground="#0078D7" VerticalAlignment="Center"/>
            <TextBlock Text="v1.0" FontSize="14" Foreground="#888888" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- Color Palette Preview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Primary Accent -->
            <Border Grid.Column="0" Margin="5" CornerRadius="8" Background="#0078D7" Height="70" x:Name="CardPrimary">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Primary Accent" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPrimaryHex" Text="#0078D7" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Secondary Accent -->
            <Border Grid.Column="1" Margin="5" CornerRadius="8" Background="#005A9E" Height="70" x:Name="CardSecondary">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Secondary" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSecondaryHex" Text="#005A9E" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Surface Accent -->
            <Border Grid.Column="2" Margin="5" CornerRadius="8" Background="#202832" Height="70" x:Name="CardSurface">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Surface Accent" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSurfaceHex" Text="#202832" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Dark Background -->
            <Border Grid.Column="3" Margin="5" CornerRadius="8" Background="#18181C" BorderBrush="#333333" BorderThickness="1" Height="70" x:Name="CardBackground">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Background" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtBackgroundHex" Text="#18181C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings & Toggles -->
        <Border Grid.Row="2" Background="#222228" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Active Integrations &amp; Controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="#0078D7"/>

                    <CheckBox x:Name="ChkSystemAccent" Content="Sync Windows System Accent Color &amp; Registry" IsChecked="True" Foreground="#FFFFFF" Margin="0,5"/>
                    <CheckBox x:Name="ChkAutoLightDark" Content="Auto Light / Dark Theme Switching" IsChecked="True" Foreground="#FFFFFF" Margin="0,5"/>
                    <CheckBox x:Name="ChkTitlebars" Content="Tint Window Titlebars &amp; Borders Live" IsChecked="True" Foreground="#FFFFFF" Margin="0,5"/>
                    <CheckBox x:Name="ChkTerminal" Content="Sync Microsoft Windows Terminal Scheme" IsChecked="True" Foreground="#FFFFFF" Margin="0,5"/>
                    <CheckBox x:Name="ChkVSCode" Content="Sync Visual Studio Code Theme (workbench.colorCustomizations)" IsChecked="True" Foreground="#FFFFFF" Margin="0,5"/>
                    <CheckBox x:Name="ChkRainmeter" Content="Sync Rainmeter Skin Colors &amp; Trigger Refresh" IsChecked="True" Foreground="#FFFFFF" Margin="0,5"/>
                    <CheckBox x:Name="ChkExportFiles" Content="Export theme.css &amp; theme.json for custom web apps / browsers" IsChecked="True" Foreground="#FFFFFF" Margin="0,5"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus" Text="Status: Watching for wallpaper changes..." Foreground="#888888" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnSyncNow" Content="⚡ Sync Now" Width="120" Height="35" Background="#0078D7" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnSyncNow_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnMinimizeTray" Content="📌 Minimize to Tray" Width="130" Height="35" Background="#333338" Foreground="#FFFFFF" Click="BtnMinimizeTray_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
