<Window x:Class="WinColorSync.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinColorSync - Wallpaper Engine System Synchronizer" Height="680" Width="760"
        Icon="../AppIcon.png"
        Background="#18181C" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Image Source="../AppIcon.png" Width="28" Height="28" Margin="0,0,10,0"/>
            <TextBlock Text="WinColorSync" FontSize="24" FontWeight="Bold" Foreground="#0078D7" VerticalAlignment="Center"/>
            <TextBlock Text="v1.0" FontSize="14" Foreground="#888888" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- Interactive Color Customizer Grid -->
        <Border Grid.Row="1" Background="#222228" CornerRadius="10" Padding="12" Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="🎨 Active Palette Customizer &amp; Manual Overrides" FontSize="15" FontWeight="SemiBold" Foreground="#0078D7" VerticalAlignment="Center"/>
                    <Button x:Name="BtnApplyCustomColors" Content="🎨 Apply Custom Colors" HorizontalAlignment="Right" Padding="10,4" Background="#6f42c1" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnApplyCustomColors_Click"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Primary Accent -->
                    <Border Grid.Row="0" Grid.Column="0" Margin="4" CornerRadius="6" Background="#18181C" Padding="8" BorderBrush="#333338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Primary Accent (UI / Icons)" FontSize="11" Foreground="#AAAAAA"/>
                            <DockPanel Margin="0,5,0,0">
                                <Border x:Name="SwatchPrimary" Width="22" Height="22" CornerRadius="4" Background="#0078D7" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtPrimaryHex" Text="#0078D7" Background="#222228" Foreground="#FFFFFF" BorderBrush="#444444" Padding="4,2" FontSize="12" TextChanged="TxtColor_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Secondary Accent -->
                    <Border Grid.Row="0" Grid.Column="1" Margin="4" CornerRadius="6" Background="#18181C" Padding="8" BorderBrush="#333338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Secondary Accent" FontSize="11" Foreground="#AAAAAA"/>
                            <DockPanel Margin="0,5,0,0">
                                <Border x:Name="SwatchSecondary" Width="22" Height="22" CornerRadius="4" Background="#005A9E" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtSecondaryHex" Text="#005A9E" Background="#222228" Foreground="#FFFFFF" BorderBrush="#444444" Padding="4,2" FontSize="12" TextChanged="TxtColor_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Window Border & Titlebar -->
                    <Border Grid.Row="0" Grid.Column="2" Margin="4" CornerRadius="6" Background="#18181C" Padding="8" BorderBrush="#333338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Window Border &amp; Titlebar" FontSize="11" Foreground="#AAAAAA"/>
                            <DockPanel Margin="0,5,0,0">
                                <Border x:Name="SwatchBorder" Width="22" Height="22" CornerRadius="4" Background="#0078D7" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtBorderHex" Text="#0078D7" Background="#222228" Foreground="#FFFFFF" BorderBrush="#444444" Padding="4,2" FontSize="12" TextChanged="TxtColor_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Text & Foreground -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="4" CornerRadius="6" Background="#18181C" Padding="8" BorderBrush="#333338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Text &amp; File Foreground" FontSize="11" Foreground="#AAAAAA"/>
                            <DockPanel Margin="0,5,0,0">
                                <Border x:Name="SwatchText" Width="22" Height="22" CornerRadius="4" Background="#FFFFFF" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtTextHex" Text="#FFFFFF" Background="#222228" Foreground="#FFFFFF" BorderBrush="#444444" Padding="4,2" FontSize="12" TextChanged="TxtColor_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Surface / Panel Accent -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="4" CornerRadius="6" Background="#18181C" Padding="8" BorderBrush="#333338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Surface / File Pilot Panel" FontSize="11" Foreground="#AAAAAA"/>
                            <DockPanel Margin="0,5,0,0">
                                <Border x:Name="SwatchSurface" Width="22" Height="22" CornerRadius="4" Background="#202832" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtSurfaceHex" Text="#202832" Background="#222228" Foreground="#FFFFFF" BorderBrush="#444444" Padding="4,2" FontSize="12" TextChanged="TxtColor_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Background Color -->
                    <Border Grid.Row="1" Grid.Column="2" Margin="4" CornerRadius="6" Background="#18181C" Padding="8" BorderBrush="#333338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Dark Background Color" FontSize="11" Foreground="#AAAAAA"/>
                            <DockPanel Margin="0,5,0,0">
                                <Border x:Name="SwatchBackground" Width="22" Height="22" CornerRadius="4" Background="#18181C" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtBackgroundHex" Text="#18181C" Background="#222228" Foreground="#FFFFFF" BorderBrush="#444444" Padding="4,2" FontSize="12" TextChanged="TxtColor_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Settings & Toggles -->
        <Border Grid.Row="2" Background="#222228" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="⚙️ Active Integrations &amp; Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#0078D7"/>

                    <CheckBox x:Name="ChkSystemAccent" Content="Sync Windows System Accent Color &amp; Registry" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>
                    <CheckBox x:Name="ChkAutoLightDark" Content="Auto Light / Dark Theme Switching" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>
                    <CheckBox x:Name="ChkTitlebars" Content="Tint Window Titlebars &amp; Borders Live" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>
                    <CheckBox x:Name="ChkTerminal" Content="Sync Microsoft Windows Terminal Scheme" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>
                    <CheckBox x:Name="ChkVSCode" Content="Sync Visual Studio Code Theme (workbench.colorCustomizations)" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>
                    <CheckBox x:Name="ChkFilePilot" Content="Sync Voidstar File Pilot Theme (FPilot-Config.json)" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>
                    <CheckBox x:Name="ChkRainmeter" Content="Sync Rainmeter Skin Colors &amp; Trigger Refresh" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>
                    <CheckBox x:Name="ChkExportFiles" Content="Export theme.css &amp; theme.json for custom web apps / browsers" IsChecked="True" Foreground="#FFFFFF" Margin="0,4"/>

                    <!-- Custom Wallpaper Engine Folder Input -->
                    <TextBlock Text="Wallpaper Engine Path:" Foreground="#AAAAAA" FontSize="12" Margin="0,10,0,4"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtWpPath" Background="#18181C" Foreground="#FFFFFF" BorderBrush="#444444" Padding="5" FontSize="12"/>
                        <Button Grid.Column="1" x:Name="BtnAutoDetect" Content="🔍 Auto-Detect" Margin="8,0,0,0" Padding="10,4" Background="#0078D7" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnAutoDetect_Click"/>
                        <Button Grid.Column="2" x:Name="BtnBrowsePath" Content="📁 Browse..." Margin="6,0,0,0" Padding="10,4" Background="#333338" Foreground="#FFFFFF" Click="BtnBrowsePath_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus" Text="Status: Ready" Foreground="#888888" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnSaveSettings" Content="💾 Save Settings" Width="110" Height="35" Background="#28a745" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnSaveSettings_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnCaptureScreen" Content="📸 Screen Capture" Width="120" Height="35" Background="#6f42c1" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnCaptureScreen_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnSyncNow" Content="⚡ Sync Now" Width="100" Height="35" Background="#0078D7" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnSyncNow_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnMinimizeTray" Content="📌 Tray" Width="60" Height="35" Background="#333338" Foreground="#FFFFFF" Click="BtnMinimizeTray_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
